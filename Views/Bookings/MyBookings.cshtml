@model IEnumerable<Booking>
@{ ViewData["Title"] = "My bookings"; }
<h1 class="h2 mb-3">My bookings</h1>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Resource</th><th>Date</th><th>Time</th><th>Purpose</th><th>Status</th><th></th></tr></thead><tbody>
@foreach (var b in Model) {
<tr><td>@b.Resource?.Name</td><td>@b.BookingDate.ToString("yyyy-MM-dd")</td><td>@b.StartTime.ToString(@"hh\:mm")–@b.EndTime.ToString(@"hh\:mm")</td><td>@b.Purpose</td><td><span class="badge @StatusClass(b.Status)">@b.Status</span></td><td>
@if ((b.Status == BookingStatus.Pending || b.Status == BookingStatus.Approved) && (b.BookingDate.Date > DateTime.Today || (b.BookingDate.Date == DateTime.Today && b.StartTime > DateTime.Now.TimeOfDay))) {
<form asp-action="Cancel" method="post" asp-route-id="@b.Id" onsubmit="return confirm('Cancel this booking?');"><button class="btn btn-sm btn-outline-danger">Cancel</button></form>
}
</td></tr>
}
</tbody></table></div>
@if (!Model.Any()) { <div class="empty-state">You haven't submitted any booking requests yet.</div> }
@functions { string StatusClass(BookingStatus s) => s switch { BookingStatus.Approved => "text-bg-success", BookingStatus.Rejected => "text-bg-danger", BookingStatus.Cancelled => "text-bg-secondary", _ => "text-bg-warning" }; }
