@model IEnumerable<Booking>
@{ ViewData["Title"] = "Manage bookings"; }
<h1 class="h2">Manage bookings</h1>
<form method="get" class="mb-3 d-flex gap-2"><select name="status" class="form-select" style="max-width:240px"><option value="">All statuses</option>@foreach (BookingStatus s in Enum.GetValues<BookingStatus>()) { <option value="@s" selected="@(ViewBag.Status is BookingStatus selected && selected == s)">@s</option> }</select><button class="btn btn-outline-primary">Filter</button></form>
<div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>User</th><th>Resource</th><th>Date</th><th>Time</th><th>Purpose</th><th>Status</th><th>Actions</th></tr></thead><tbody>
@foreach (var b in Model) {
<tr><td>@b.User?.Email</td><td>@b.Resource?.Name</td><td>@b.BookingDate.ToString("yyyy-MM-dd")</td><td>@b.StartTime.ToString(@"hh\:mm")–@b.EndTime.ToString(@"hh\:mm")</td><td>@b.Purpose</td><td><span class="badge @(b.Status == BookingStatus.Approved ? "text-bg-success" : b.Status == BookingStatus.Rejected ? "text-bg-danger" : b.Status == BookingStatus.Cancelled ? "text-bg-secondary" : "text-bg-warning")">@b.Status</span></td><td>
@if (b.Status == BookingStatus.Pending) {
<form asp-action="Approve" method="post" asp-route-id="@b.Id" class="d-inline"><button class="btn btn-sm btn-success mb-1">Approve</button></form>
<form asp-action="Reject" method="post" asp-route-id="@b.Id" class="d-inline"><input name="note" class="form-control form-control-sm d-inline-block mb-1" style="width:110px" placeholder="Reason (optional)" /><button class="btn btn-sm btn-outline-danger mb-1">Reject</button></form>
}
</td></tr>
}
</tbody></table></div>
@if (!Model.Any()) { <div class="empty-state">No bookings found.</div> }
