@model Resource
@{ ViewData["Title"] = "Resource details"; }
<div class="card"><div class="card-body p-4">
<div class="d-flex justify-content-between"><span class="badge text-bg-primary">@Model.Category</span><span class="badge @(Model.IsAvailable ? "text-bg-success" : "text-bg-secondary")">@(Model.IsAvailable ? "Available" : "Unavailable")</span></div>
<h1 class="h2 mt-3">@Model.Name</h1><p class="text-muted">📍 @Model.Location · Capacity: @Model.Capacity</p><p>@Model.Description</p>
@if (Model.IsAvailable && User.Identity?.IsAuthenticated == true) { <a class="btn btn-primary" asp-controller="Bookings" asp-action="Create" asp-route-resourceId="@Model.Id">Request booking</a> }
<a class="btn btn-outline-secondary" asp-action="Index">Back to resources</a>
@if (User.IsInRole("Admin")) { <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a> }
</div></div>
