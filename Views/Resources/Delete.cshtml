@model Resource
@{ ViewData["Title"] = "Delete resource"; }
<div class="alert alert-warning"><h1 class="h3">Delete resource?</h1><p>You're about to delete <strong>@Model.Name</strong>. Resources with booking history cannot be deleted.</p>
<form asp-action="Delete" method="post"><input type="hidden" asp-for="Id" /><button class="btn btn-danger">Delete</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form></div>
